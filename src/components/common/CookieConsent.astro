---
/*
  Consenso cookie (Iubenda) + Meta Pixel.

  - Lo script Iubenda va per primo: gestisce banner, blocco preventivo degli script
    e Google Consent Mode (gia' configurati da dashboard).
  - Il Meta Pixel e' taggato _iub_cs_activate-inline / type="text/plain" /
    data-iub-purposes="5" (Marketing): resta inerte finche' non c'e' il consenso
    marketing, poi Iubenda lo attiva. Nessun cookie di profilazione prima del consenso.
  - PageView iniziale dentro lo snippet (scatta quando Iubenda attiva lo script).
    Per le navigazioni soft (View Transitions) c'e' un listener su astro:after-swap.

  Tag Google Ads (da aggiungere quando l'account sara' pronto): gtag.js e' nativamente
  compatibile con Google Consent Mode, quindi NON va taggato text/plain, si incolla
  normale e Consent Mode lo regola. Esempio:
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-XXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'AW-XXXXXXXXX');
    </script>
*/
---

<!-- Iubenda: banner cookie, blocco preventivo, Google Consent Mode -->
<script
  is:inline
  type="text/javascript"
  src="https://embeds.iubenda.com/widgets/6a386027-591e-4f41-8368-595773ec1d3e.js"></script>

<!-- Meta Pixel: inerte finche' non c'e' il consenso marketing (Iubenda, purpose 5) -->
<script is:inline class="_iub_cs_activate-inline" type="text/plain" data-iub-purposes="5">
  /* eslint-disable */
  !(function (f, b, e, v, n, t, s) {
    if (f.fbq) return;
    n = f.fbq = function () {
      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
    };
    if (!f._fbq) f._fbq = n;
    n.push = n;
    n.loaded = !0;
    n.version = '2.0';
    n.queue = [];
    t = b.createElement(e);
    t.async = !0;
    t.src = v;
    s = b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t, s);
  })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '1080826707601884');
  fbq('track', 'PageView');
</script>

<!-- PageView del Pixel a ogni navigazione soft (View Transitions) -->
<script is:inline>
  document.addEventListener('astro:after-swap', function () {
    if (typeof window.fbq === 'function') {
      window.fbq('track', 'PageView');
    }
  });
</script>
