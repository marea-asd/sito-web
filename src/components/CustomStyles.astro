---
import '@fontsource-variable/inter';
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/spectral/400.css';
import '@fontsource/spectral/500.css';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Spectral';
    --aw-font-heading: 'Spectral';
    --aw-font-display: 'Cinzel';

    --aw-color-primary: rgb(218 28 28);
    --aw-color-secondary: rgb(183 21 21);
    --aw-color-accent: rgb(230 182 54);

    --aw-color-text-heading: rgb(26 26 26);
    --aw-color-text-default: rgb(26 26 26);
    --aw-color-text-muted: rgb(26 26 26 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(26 26 26);

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Spectral';
    --aw-font-heading: 'Spectral';
    --aw-font-display: 'Cinzel';

    --aw-color-primary: rgb(218 28 28);
    --aw-color-secondary: rgb(183 21 21);
    --aw-color-accent: rgb(230 182 54);

    --aw-color-text-heading: rgb(255 255 255);
    --aw-color-text-default: rgb(229 229 229);
    --aw-color-text-muted: rgb(229 229 229 / 66%);
    --aw-color-bg-page: rgb(26 26 26);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
