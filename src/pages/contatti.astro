---
import Layout from '~/layouts/PageLayout.astro';
import { Image as FigureImage } from 'astro:assets';
import figuraContatti from '~/assets/images/figura-contatti.png';

const metadata = {
  title: "Contatti — Sala d'armi Marea, Catania",
  description:
    "Scrivici, chiamaci, o passa in sala in Via Grasso Finocchiaro 63 a Catania. Sala d'armi Marea, scuola di scherma storica medievale e rinascimentale.",
};
---

<Layout metadata={metadata}>
  <section class="bg-[#FAF6EE] dark:bg-slate-900 not-prose">
    <div class="max-w-6xl mx-auto px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="grid md:grid-cols-[auto_1fr] gap-8 md:gap-12 items-center">
        <div>
          <FigureImage
            src={figuraContatti}
            alt=""
            widths={[400, 600, 900]}
            sizes="(max-width: 767px) 75vw, 40vw"
            class="mx-auto w-auto max-h-[26rem]"
          />
        </div>
        <div class="max-w-2xl">
          <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">Contatti</h1>
          <p class="text-xl text-muted dark:text-slate-400">
            Per informazioni sui corsi, per visitare la sala, o per proposte di collaborazione, scegli il canale che
            preferisci.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white dark:bg-black not-prose">
    <div class="max-w-6xl mx-auto px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="grid md:grid-cols-5 gap-8 md:gap-12">
        <div class="md:col-span-2 space-y-8">
          <div>
            <h2 class="text-lg font-bold mb-2">Dove siamo</h2>
            <a
              href="https://www.google.com/maps/search/?api=1&query=Via+Grasso+Finocchiaro+63+Catania"
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted dark:text-slate-400 hover:text-primary transition"
            >
              <address class="not-italic">
                Via Grasso Finocchiaro 63<br />
                95126 Catania (CT)
              </address>
            </a>
          </div>

          <div>
            <h2 class="text-lg font-bold mb-2">Telefono</h2>
            <a href="tel:+393401496622" class="text-muted dark:text-slate-400 hover:text-primary transition">
              +39 340 14 96 622
            </a>
          </div>

          <div>
            <h2 class="text-lg font-bold mb-2">Email</h2>
            <a
              href="mailto:info@saladarmimarea.it"
              class="text-muted dark:text-slate-400 hover:text-primary transition"
            >
              info@saladarmimarea.it
            </a>
          </div>

          <div>
            <h2 class="text-lg font-bold mb-2">Social</h2>
            <div class="flex flex-col gap-2">
              <a
                href="https://www.facebook.com/SchermaStoricaCataniaReal"
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted dark:text-slate-400 hover:text-primary transition"
              >
                Facebook
              </a>
              <a
                href="https://www.instagram.com/scherma_storica_catania_marea/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted dark:text-slate-400 hover:text-primary transition"
              >
                Instagram
              </a>
              <a
                href="https://www.youtube.com/@GiuseppePioletti"
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted dark:text-slate-400 hover:text-primary transition"
              >
                YouTube
              </a>
            </div>
          </div>
        </div>

        <div class="md:col-span-3">
          <div class="relative aspect-video w-full rounded-lg overflow-hidden shadow-md">
            <iframe
              id="map-frame"
              data-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3164.289750058024!2d15.103360611139898!3d37.52466652641178!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1313fd64ca27df0d%3A0x8dd72156baa02fe5!2sScherma%20Storica%20Catania%20-%20Sala%20d'armi%20Marea!5e0!3m2!1sit!2sit!4v1779377402121!5m2!1sit!2sit"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Mappa Sala d'armi Marea su Google Maps"></iframe>
            <button
              id="map-load-btn"
              type="button"
              class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-gray-50 dark:bg-slate-800 hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors cursor-pointer text-center px-6 font-sans"
            >
              <span class="font-semibold text-default dark:text-slate-200">Mostra la mappa</span>
              <span class="text-sm text-muted dark:text-slate-400"
                >La mappa è fornita da Google Maps e viene caricata solo al tuo clic.</span
              >
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const mapBtn = document.getElementById('map-load-btn');
    const mapFrame = document.getElementById('map-frame');
    if (mapBtn instanceof HTMLButtonElement && mapFrame instanceof HTMLIFrameElement) {
      mapBtn.addEventListener('click', () => {
        const src = mapFrame.getAttribute('data-src');
        if (src) mapFrame.src = src;
        mapBtn.remove();
      });
    }
  </script>
</Layout>
