---
import Layout from '~/layouts/PageLayout.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: "Lezione di prova gratuita | Sala d'armi Marea",
  description:
    'Prova la scherma storica medievale e rinascimentale a Catania. Gratuita, nessuna esperienza richiesta, nella forma di un Open Day stagionale.',
};
---

<Layout metadata={metadata}>
  <!-- Hero *************************** -->

  <section class="relative bg-black not-prose overflow-hidden">
    <Image
      src="~/assets/images/lezione-di-prova.jpg"
      alt=""
      width={1794}
      height={877}
      widths={[640, 960, 1280, 1794]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover !object-top !max-w-none !max-h-none"
    />
    <div class="absolute inset-0 bg-black/50" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 py-20 md:py-28 text-center">
      <h1 class="font-heading text-4xl md:text-5xl font-medium leading-tight text-white mb-6">
        Stupisci te stesso, combatti come un vero cavaliere medievale
      </h1>
      <p class="font-sans text-xl text-white/90 leading-relaxed mb-10 max-w-2xl mx-auto">
        La lezione di prova è gratuita e aperta a tutti, a chi ha già esperienza e a chi tocca la spada per la prima
        volta. È un'ora in cui provi la nostra disciplina, guidato passo passo dai nostri istruttori. Le prove si
        tengono come Open Day stagionali: lascia i tuoi contatti qui sotto e ti avvisiamo appena è fissata la data del
        prossimo.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#modulo"
          class="inline-block bg-primary text-white font-semibold rounded-full px-8 py-4 hover:opacity-90 transition-opacity"
          >Avvisami del prossimo Open Day</a
        >
        <a
          href="/corso-base"
          class="inline-block border-2 border-white text-white font-semibold rounded-full px-8 py-4 hover:bg-white hover:text-black transition-colors"
          >Scopri il Corso Base</a
        >
      </div>
    </div>
  </section>

  <!-- Cosa farai ******************** -->

  <section class="bg-[#FAF6EE] dark:bg-slate-900 not-prose">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-20">
      <h2
        class="font-heading text-4xl md:text-5xl font-medium leading-tight text-heading dark:text-white mb-8 text-center"
      >
        Cosa farai
      </h2>
      <div class="space-y-6 font-sans text-lg leading-relaxed text-default dark:text-slate-300">
        <p>
          In un'ora proverai le emozioni di un vero cavaliere medievale. Non serve esperienza e non serve preparazione:
          esplorerai l'Arte della spada un gesto alla volta.
        </p>
        <p>
          I nostri istruttori ti guideranno dalle basi a realizzare la prima tecnica tratta dal trattato di Fiore dei
          Liberi, una di quelle che rendono quest'Arte sorprendente da vedere e da eseguire.
        </p>
        <p>
          Chi vorrà proseguire ritroverà la stessa Arte nel Corso Base, dove si costruisce con metodo dalla prima
          impugnatura al primo duello.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ *************************** -->

  <FAQs
    title="Domande frequenti"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: "Cos'è la lezione di prova?",
        description:
          "È un Open Day gratuito e aperto a tutti: un'ora informale per provare la scherma storica. È pensata per chi si avvicina per la prima volta, con o senza esperienza, e serve a farti scoprire la disciplina dal vivo prima di decidere se iniziare il percorso. Chi vorrà proseguire troverà il corso vero e proprio nel Corso Base.",
      },
      {
        title: 'Quando si parte?',
        description:
          'Le prove si tengono come Open Day stagionali, e le date vengono fissate di volta in volta. Per questo non trovi un calendario da prenotare: lasci i tuoi contatti nel modulo qui sotto e ti scriviamo noi appena è fissata la data del prossimo Open Day, così puoi decidere con calma se esserci.',
      },
      {
        title: 'Cosa succede dopo che lascio i contatti?',
        description:
          'Al resto pensiamo noi. Teniamo i tuoi contatti e, appena è fissata la data del prossimo Open Day, ti scriviamo con tutti i dettagli: dove, quando e come arrivare pronto. Da lì decidi con calma se venire.',
      },
      {
        title: "C'è un'età minima?",
        description: 'Sì, gli Open Day e i corsi sono riservati ai maggiorenni, dai 18 anni in su.',
      },
      {
        title: 'Cosa devo portare?',
        description:
          'Ai simulacri pensiamo noi: le spade da allenamento le mette a disposizione la scuola. A te basta un abbigliamento sportivo comodo e un paio di scarpe da ginnastica.',
      },
      {
        title: 'Serve il certificato medico?',
        description:
          "Sì, serve il certificato di idoneità all'attività sportiva non agonistica (oppure agonistica se preferisci). Attenzione a non richiedere quello per attività ludico-motoria, che non è valido per la nostra attività.",
      },
      {
        title: 'Il certificato medico serve anche per la lezione di prova?',
        description: 'Sì, assolutamente. Controlla che sia quello giusto e, per qualsiasi dubbio, contattaci.',
      },
    ]}
  />

  <!-- Modulo waitlist *************** -->

  <section id="modulo" class="bg-[#FAF6EE] dark:bg-slate-900 not-prose scroll-mt-24">
    <div class="max-w-xl mx-auto px-4 sm:px-6 py-12 md:py-20">
      <h2
        class="font-heading text-4xl md:text-5xl font-medium leading-tight text-heading dark:text-white mb-4 text-center"
        id="form-heading"
      >
        Avvisami del prossimo Open Day
      </h2>
      <p id="form-intro" class="font-sans text-lg text-muted dark:text-slate-300 leading-relaxed mb-8 text-center">
        Lascia i tuoi contatti e ti scriviamo appena è fissata la data del prossimo Open Day.
      </p>

      <form id="waitlist-form" class="font-sans space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="nome" class="block text-sm font-medium text-default dark:text-slate-200 mb-1">Nome</label>
            <input
              type="text"
              id="nome"
              name="nome"
              required
              autocomplete="given-name"
              class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-3 text-default dark:text-slate-100 focus:border-primary focus:ring-1 focus:ring-primary outline-none"
            />
          </div>
          <div>
            <label for="cognome" class="block text-sm font-medium text-default dark:text-slate-200 mb-1">Cognome</label>
            <input
              type="text"
              id="cognome"
              name="cognome"
              required
              autocomplete="family-name"
              class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-3 text-default dark:text-slate-100 focus:border-primary focus:ring-1 focus:ring-primary outline-none"
            />
          </div>
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-default dark:text-slate-200 mb-1">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-3 text-default dark:text-slate-100 focus:border-primary focus:ring-1 focus:ring-primary outline-none"
          />
        </div>

        <div>
          <label for="conferma-email" class="block text-sm font-medium text-default dark:text-slate-200 mb-1">
            Conferma email
          </label>
          <input
            type="email"
            id="conferma-email"
            name="confermaEmail"
            required
            autocomplete="email"
            class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-3 text-default dark:text-slate-100 focus:border-primary focus:ring-1 focus:ring-primary outline-none"
          />
          <p id="email-mismatch" class="hidden text-sm text-primary mt-1">Le due email non coincidono.</p>
        </div>

        <div>
          <label for="telefono" class="block text-sm font-medium text-default dark:text-slate-200 mb-1">Telefono</label>
          <input
            type="tel"
            id="telefono"
            name="telefono"
            required
            autocomplete="tel"
            class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-3 text-default dark:text-slate-100 focus:border-primary focus:ring-1 focus:ring-primary outline-none"
          />
        </div>

        <label class="flex items-start gap-3 text-sm text-muted dark:text-slate-300">
          <input
            type="checkbox"
            id="consenso"
            name="consenso"
            required
            class="mt-1 h-4 w-4 shrink-0 rounded border-gray-300 dark:border-slate-600 text-primary focus:ring-primary"
          />
          <span>
            Ho letto l'<a
              href="https://www.iubenda.com/privacy-policy/64525115"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary underline">informativa sulla privacy</a
            > e acconsento al trattamento dei miei dati per essere ricontattato.
          </span>
        </label>

        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-primary text-white font-semibold rounded-full px-8 py-4 hover:opacity-90 transition-opacity disabled:opacity-60"
        >
          Avvisami
        </button>

        <p id="form-error" class="hidden text-center text-sm text-primary">
          Qualcosa è andato storto. Riprova tra poco o scrivici.
        </p>
      </form>

      <div id="form-success" class="hidden text-center">
        <div
          class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-[#E6B636]"
          aria-hidden="true"
        >
          <Icon name="tabler:check" class="h-8 w-8 text-white" />
        </div>
        <h2 class="font-heading text-4xl md:text-5xl font-medium leading-tight text-heading dark:text-white mb-4">
          Ci siamo!
        </h2>
        <p class="font-sans text-lg text-muted dark:text-slate-300 leading-relaxed">
          Abbiamo ricevuto i tuoi contatti e ti scriviamo appena è fissata la data del prossimo Open Day. A presto!
        </p>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('waitlist-form');
    const successEl = document.getElementById('form-success');
    const errorEl = document.getElementById('form-error');
    const mismatchEl = document.getElementById('email-mismatch');
    const submitBtn = document.getElementById('submit-btn');

    if (form instanceof HTMLFormElement && submitBtn instanceof HTMLButtonElement) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorEl?.classList.add('hidden');
        mismatchEl?.classList.add('hidden');

        const formData = new FormData(form);
        const email = String(formData.get('email') || '').trim();
        const confermaEmail = String(formData.get('confermaEmail') || '').trim();

        if (email !== confermaEmail) {
          mismatchEl?.classList.remove('hidden');
          return;
        }

        const payload = {
          nome: String(formData.get('nome') || '').trim(),
          cognome: String(formData.get('cognome') || '').trim(),
          email,
          telefono: String(formData.get('telefono') || '').trim(),
          consenso: formData.get('consenso') === 'on',
        };

        submitBtn.disabled = true;
        submitBtn.textContent = 'Invio in corso...';

        try {
          const response = await fetch('/api/waitlist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!response.ok) throw new Error('Request failed');
          form.classList.add('hidden');
          document.getElementById('form-heading')?.classList.add('hidden');
          document.getElementById('form-intro')?.classList.add('hidden');
          successEl?.classList.remove('hidden');
        } catch {
          errorEl?.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Avvisami';
        }
      });
    }
  </script>
</Layout>
