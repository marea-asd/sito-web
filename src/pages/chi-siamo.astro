---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { Image as FigureImage } from 'astro:assets';
import fondatoreImg from '~/assets/images/fondatore.png';

const metadata = {
  title: "Chi siamo — Sala d'armi Marea",
  description:
    'La prima scuola di scherma storica medievale e rinascimentale in Sicilia. Studio dei trattati del Maestro Fiore dei Liberi e dei maestri italiani del Rinascimento, biomeccanica applicata, sicurezza tecnica. Fondata da Giuseppe Pioletti.',
};
---

<Layout metadata={metadata}>
  <!-- Hero *************************** -->

  <section class="relative bg-black not-prose overflow-hidden">
    <Image
      src="~/assets/images/chi-siamo.jpg"
      alt=""
      width={1794}
      height={877}
      widths={[640, 960, 1280, 1794]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover !object-top !max-w-none !max-h-none"
    />
    <div class="absolute inset-0 bg-black/40" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 py-20 md:py-28 text-center">
      <h1 class="font-heading text-4xl md:text-5xl font-medium leading-tight text-white mb-6">Chi siamo</h1>
      <p class="font-sans text-xl text-white/90 leading-relaxed max-w-2xl mx-auto">
        La prima scuola di scherma storica medievale e rinascimentale in Sicilia, dal 2020.
      </p>
    </div>
  </section>

  <!-- La nostra storia ************** -->

  <section class="bg-[#FAF6EE] dark:bg-slate-900 not-prose">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-20">
      <h2
        class="font-heading text-4xl md:text-5xl font-medium leading-tight text-heading dark:text-white mb-8 text-center"
      >
        La nostra storia
      </h2>
      <div class="space-y-6 font-sans text-lg leading-relaxed text-default dark:text-slate-300">
        <p>
          Sala Marea nasce nel 2020 dall'ambizioso progetto del suo fondatore, Giuseppe Pioletti, di creare in Sicilia
          una scuola dove la grande Arte dei Maestri d'arme di medioevo e rinascimento fosse riportata in vita, con
          passione, con rigore storico e con rispetto per il corpo di chi la pratica.
        </p>
        <p>
          Da quel momento intorno alla Sala è cresciuta una comunità di appassionati, uniti dalla stessa visione:
          prendere sul serio, con eguale cura, la fedeltà storica dei trattati e l'autenticità marziale del gesto.
        </p>
        <p>
          Chi si allena in Sala non porta a casa soltanto la tecnica: porta un corpo più forte, una mente più salda, il
          sapere vivo dei trattati e il legame di una fratellanza d'arme.
        </p>
      </div>
    </div>
  </section>

  <!-- I nostri valori ************** -->

  <section class="bg-white dark:bg-black not-prose">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-20">
      <h2
        class="font-heading text-4xl md:text-5xl font-medium leading-tight text-heading dark:text-white mb-12 text-center"
      >
        I nostri valori
      </h2>
      <div class="grid gap-10 md:grid-cols-3">
        <div>
          <h3 class="font-display uppercase tracking-wider text-lg text-primary mb-3">Inclusività</h3>
          <p class="font-sans text-base leading-relaxed text-default dark:text-slate-300">
            Il patrimonio fisico e morale custodito nei trattati del medioevo e del rinascimento italiano appartiene a
            tutti: studiarlo e farlo proprio è un diritto di chiunque voglia incamminarsi su questa via. Per questo, a
            prescindere da sesso, età o livello di partenza, chi pratica in Sala trova un ambiente in cui sentirsi
            accolto e guidato, mai vulnerabile né giudicato.
          </p>
        </div>
        <div>
          <h3 class="font-display uppercase tracking-wider text-lg text-primary mb-3">Professionalità</h3>
          <p class="font-sans text-base leading-relaxed text-default dark:text-slate-300">
            Imparare quest'arte è un percorso lungo e a tratti faticoso, e va accompagnato con serietà: in Sala
            pretendiamo la massima professionalità, dagli istruttori come dagli allievi. È un rigore che nasce dalle
            fonti stesse, perché dalla trattatistica antica emerge una vera cultura del corpo e del movimento
            funzionale, fatta di cura del gesto, equilibrio nelle proporzioni e rispetto delle articolazioni.
          </p>
        </div>
        <div>
          <h3 class="font-display uppercase tracking-wider text-lg text-primary mb-3">Autenticità</h3>
          <p class="font-sans text-base leading-relaxed text-default dark:text-slate-300">
            La nostra pratica è ancorata alle fonti. Ogni azione e ogni tecnica che insegniamo è scelta con rigore dai
            trattati del periodo di riferimento, per mantenere viva la marzialità autentica del gesto e la sua
            attendibilità storica.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Il fondatore ***************** -->

  <section class="bg-[#FAF6EE] dark:bg-slate-900 not-prose">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-20">
      <h2
        class="font-heading text-4xl md:text-5xl font-medium leading-tight text-heading dark:text-white mb-3 text-center"
      >
        Fondatore, Magister e Responsabile operativo
      </h2>
      <p class="font-display uppercase tracking-wider text-primary text-center mb-10">Giuseppe A. Pioletti</p>
      <div class="grid md:grid-cols-[auto_1fr] gap-8 md:gap-12 items-start">
        <div class="md:sticky md:top-24">
          <FigureImage
            src={fondatoreImg}
            alt="Giuseppe Pioletti"
            widths={[400, 600, 1198]}
            sizes="(max-width: 767px) 75vw, 40vw"
            class="mx-auto w-auto max-h-[26rem]"
          />
        </div>
        <div class="space-y-6 font-sans text-lg leading-relaxed text-default dark:text-slate-300">
          <p>
            Giuseppe pratica arti marziali dal 1995. Ha cominciato con le discipline orientali, e per anni ha cercato in
            esse qualcosa che sentiva mancare: una storia che fosse anche la sua. L'ha trovata nel 2013, quando si è
            avvicinato alla scherma medievale nei contesti rievocativi.
          </p>
          <p>
            Questa passione lo ha portato nel 2020 a fondare, in collaborazione con CSEN, la prima sala di Scherma
            storica in Sicilia: Sala Marea.
          </p>
          <p>
            Il suo dottorato di ricerca in Storia e la laurea in Scienze Motorie, con Master in Posturologia e
            Biomeccanica, gli hanno fornito gli strumenti per creare un ponte tra due mondi. Da un lato il rigore per
            leggere e interpretare i trattati di combattimento medievali e rinascimentali; dall'altro la competenza
            tecnica e biomeccanica per capire come quei gesti funzionino davvero nel corpo.
          </p>
          <p>
            La sua attività di ricerca e il suo insegnamento si basano sull'interpretazione della trattatistica italiana
            del medioevo e del rinascimento, fondata sulla coerenza storica e biomeccanica. È qui che le sue due grandi
            passioni si incontrano, il ruolo di allenatore e posturologo e l'impegno nella ricerca storica e filosofica,
            perché le tecniche tramandate dai grandi Maestri del passato incarnano l'essenza di un allenamento davvero
            funzionale.
          </p>
          <p>
            I loro trattati, scritti per praticanti adulti, custodiscono un patrimonio immenso di conoscenze fisiche e
            biomeccaniche, pensate per insegnare un movimento sano, efficace e armonioso: esattamente ciò che serve per
            mantenere un corpo forte lungo tutto l'arco della vita.
          </p>
          <p>
            Come fondatore di Sala Marea, Giuseppe si occupa della gestione e del coordinamento delle attività
            didattiche, sportive e della comunicazione. Ma prima di ogni ruolo, resta un praticante e un ricercatore,
            mosso dalla stessa convinzione di sempre: che studiare l'Arte dei Maestri significhi, insieme, custodire la
            nostra storia e diffondere un autentico benessere, fisico e mentale.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cosa dicono di noi *********** -->

  <section class="bg-white dark:bg-black not-prose">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-20">
      <h2
        class="font-heading text-4xl md:text-5xl font-medium leading-tight text-heading dark:text-white mb-10 text-center"
      >
        Cosa dicono di noi
      </h2>
      <div class="space-y-6">
        <figure class="rounded-lg border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800 p-6 sm:p-8">
          <blockquote class="font-sans text-lg leading-relaxed text-default dark:text-slate-300">
            "Avevo riposto molte speranze in questa arte marziale, e posso dire che sono state tutte pienamente
            soddisfatte. Il Maestro Giuseppe Pioletti cura ogni aspetto dell'attività sportiva: la conoscenza delle
            potenzialità fisiche del corpo, la marzialità che giace dietro alla schermistica italiana, e l'aspetto
            umano. Se cercate una sala di scherma storica degna dell'importanza e del rispetto che essa merita, Marea fa
            per voi."
          </blockquote>
          <figcaption class="mt-4 font-display uppercase tracking-wider text-primary text-sm">Manuel S.</figcaption>
        </figure>
        <figure class="rounded-lg border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800 p-6 sm:p-8">
          <blockquote class="font-sans text-lg leading-relaxed text-default dark:text-slate-300">
            "Questa sala d'armi è un'oasi felice qui a Catania per chiunque sia interessato ad apprendere seriamente la
            scherma tardomedievale e rinascimentale. Gli insegnamenti del maestro Giuseppe Pioletti infatti, oltre a
            partire da un'approfondita conoscenza delle fonti, sono supportati anche dalla sperimentazione pratica di
            quanto scritto nei trattati, oltre che da un'eccellente conoscenza della didattica e di quanto concerne la
            motricità. Lo spirito di gruppo che si è creato tra gli allievi è stupendo. Se vi siete sempre sentiti dei
            'cavalieri mancati' e vorreste imparare a usare una spada come si deve (che sia sola, a due mani, col
            brocchiero oltre che magari anche una daga o addirittura un'azza!) questo è il posto giusto per voi! ⚔️"
          </blockquote>
          <figcaption class="mt-4 font-display uppercase tracking-wider text-primary text-sm">Riccardo D.M.</figcaption>
        </figure>
        <figure class="rounded-lg border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800 p-6 sm:p-8">
          <blockquote class="font-sans text-lg leading-relaxed text-default dark:text-slate-300">
            "La scherma è sempre stato qualcosa che mi ha affascinato, l'arte della spada, impugnare un oggetto così
            raffinato e quasi mistico, per come lo vediamo oggi, è sempre stato un sogno nel cassetto che ho potuto
            realizzare grazie a Giuseppe Pioletti, un istruttore che sa quello che fa e la cui professionalità si
            percepisce già al primo esercizio di stretching che farete con lui, educato, preparato e più di tutto tiene
            a cuore il benessere dei suoi allievi e lo dimostra in ogni allenamento. Che dire, se imparare quest'arte
            (perché così si definisce e si dimostra) è un vostro sogno, questo è il posto giusto. Arte, Ardore, Onore e
            Rispetto sarà quello che troverete e vi verrà dato!"
          </blockquote>
          <figcaption class="mt-4 font-display uppercase tracking-wider text-primary text-sm">Federico S.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Partner ufficiali *********** -->

  <section class="bg-[#FAF6EE] dark:bg-slate-900 not-prose">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-20 text-center">
      <h2 class="font-heading text-4xl md:text-5xl font-medium leading-tight text-heading dark:text-white mb-8">
        Partner ufficiali
      </h2>
      <a
        href="https://faitsdarmes.com/it/"
        target="_blank"
        rel="noopener noreferrer follow"
        title="Faits d'Armes: specialisti in equipaggiamento per le Arti Marziali Storiche Europee (AMHE)"
        class="inline-block"
      >
        <img
          src="/faitsdarmes-partner-728x90-black.png"
          alt="Questo club è partner ufficiale della boutique Faits d'Armes"
          width="728"
          height="90"
          loading="lazy"
          class="mx-auto h-auto w-full max-w-[728px] dark:hidden"
        />
        <img
          src="/faitsdarmes-partner-728x90-white.png"
          alt="Questo club è partner ufficiale della boutique Faits d'Armes"
          width="728"
          height="90"
          loading="lazy"
          class="mx-auto hidden h-auto w-full max-w-[728px] dark:block"
        />
      </a>
    </div>
  </section>

  <!-- CTA finale ****************** -->

  <section class="bg-primary not-prose">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 md:py-24 text-center">
      <h2 class="font-heading text-3xl md:text-4xl font-medium text-white leading-tight mb-6">Vuoi provare?</h2>
      <p class="font-sans text-lg text-white/90 leading-relaxed mb-10">Iscriviti al prossimo Open Day.</p>
      <div class="flex justify-center">
        <a
          href="/lezione-di-prova"
          class="inline-block bg-white text-primary font-semibold rounded-full border-2 border-transparent px-8 py-4 hover:bg-gray-100 transition-colors"
          >Prenota la lezione di prova</a
        >
      </div>
    </div>
  </section>
</Layout>
